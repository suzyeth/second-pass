# The build context is uploaded to Cloud Build before anything is read, so the
# films and their clips have to be excluded here rather than merely left out of
# the COPY lines — otherwise every deploy ships ~700MB of video to build an image
# that does not contain any of it.
*.mov
*.mov.zip
*.mp4
clips/
clips_audio/
films/*/clips/
films/*/beat_clips/

# Data prep and analysis. None of it runs in the container. load.py,
# load-craft.py, schema.sql and the scored files DO: the image loads its own
# ClickHouse at build time.
prepare.py
analyze.py
analyze-film.py
runq.py
mcp_probe.py
score*.js
*.json
!films.json
!tos.json
!bbb.json
!sintel.json
!films/*/scored.json
queries.sql

.git/
.gitignore
__pycache__/
*.pyc
.venv-platform/
tests/
requirements-dev.txt
run.ps1
DESIGN.md
README.md
events.jsonl
scripts/
