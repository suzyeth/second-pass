<!--
  One user, no password, loopback only. The server listens on 127.0.0.1 and
  the user is restricted to it as well, so a misconfigured listen_host still
  would not open the database to the network.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>629145600</max_memory_usage>
        </default>
    </profiles>

    <users>
        <default>
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </default>
    </users>

    <quotas>
        <default></default>
    </quotas>
</clickhouse>
